# ---------------------------------------------------------------------------
# Emerald H2 — environment template
# Copy to `.env` and fill in. `.env` is gitignored; never commit real secrets.
# ---------------------------------------------------------------------------

# --- Database ---
# LOCAL DEV (default): SQLite, zero setup.
DATABASE_URL="file:./dev.db"

# PRODUCTION (Supabase Postgres): use BOTH of these and switch the Prisma
# datasource provider to "postgresql" (see DEPLOY.md).
#   DATABASE_URL = Supabase "Transaction" pooler string (port 6543, ?pgbouncer=true)
#   DIRECT_URL   = Supabase "Session"/direct string (port 5432) — used for migrations
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Auth ---
# Secret used to sign admin session JWTs. Generate a strong one for production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-in-production"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Admin seed account (used by prisma/seed.ts) ---
# Kept out of the codebase. Set these before running the seed.
ADMIN_EMAIL="admin@ogrelogic.com"
ADMIN_PASSWORD="change-me"

# --- Web Push (added in PWA milestone M2) ---
# Generate once with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:info@emeraldh2.com"
